<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Static Sharp Wallpaper & Pre-Rendered Frosted Blur Wallpaper for Android 11+ Ambient Mode -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_wallpaper"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/heroArtBlur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_wallpaper_blur"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/heroArtNext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/scrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cinematic_scrim"
        android:importantForAccessibility="no" />

    <!-- Borderless Full-Screen Frosted Glass Overlay for 5-Min Idle Ambient Mode -->
    <View
        android:id="@+id/ambientGlassPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ambient_glass_fullscreen"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Suppressed full-screen ambient flood (accent color is now clamped strictly inside DockDecoration). -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Race-weekend panel -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Cinematic top shelf scrim -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name or active top capsule tool label -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:layout_marginTop="160dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Disabled Spotlight Container -->
    <LinearLayout
        android:id="@+id/openSpotlightContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="48dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="20dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvHeroSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.20"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="32sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:singleLine="true" />

        <TextView
            android:id="@+id/spotlightController"
            style="@style/TopButton"
            android:layout_marginTop="8dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:minWidth="96dp"
            android:text="Info"
            android:drawableStart="@null"
            android:drawableEnd="@null"
            android:clipToPadding="false"
            android:nextFocusDown="@+id/grid" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@string/font_light"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <TextClock
                            android:id="@+id/date"
                            android:gravity="left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:format12Hour="@string/date_format_home"
                            android:format24Hour="@string/date_format_home"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <!-- Top Navigation: Pill A (Quick Icons) + Pill B (Settings Button) -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clipChildren="true"
                android:clipToPadding="false">

                <!-- Pill A: 5 Equal-Spaced Quick Control Icon Cells (44x44, 4dp gap, 8dp padding all sides) -->
                <LinearLayout
                    android:id="@+id/pillQuickControls"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_top_capsule"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:clipChildren="true"
                    android:clipToPadding="false">

                    <!-- 1. Jio Box (HDMI 2) -->
                    <TextView
                        android:id="@+id/btnJioBox"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_icon_subtle_bg"
                        android:contentDescription="Jio Box"
                        android:drawableStart="@drawable/ic_jiobox"
                        android:drawablePadding="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusRight="@+id/btnWifi"
                        android:nextFocusDown="@+id/grid" />

                    <!-- 2. Wi-Fi -->
                    <TextView
                        android:id="@+id/btnWifi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_icon_subtle_bg"
                        android:contentDescription="@string/wifi"
                        android:drawableStart="@drawable/ic_wifi_signal"
                        android:drawablePadding="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusLeft="@+id/btnJioBox"
                        android:nextFocusRight="@+id/btnScreensaver"
                        android:nextFocusDown="@+id/grid" />

                    <!-- 3. Screensaver -->
                    <TextView
                        android:id="@+id/btnScreensaver"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_icon_subtle_bg"
                        android:contentDescription="Screensaver"
                        android:drawableStart="@drawable/ic_screensaver"
                        android:drawablePadding="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusLeft="@+id/btnWifi"
                        android:nextFocusRight="@+id/btnRam"
                        android:nextFocusDown="@+id/grid" />

                    <!-- 4. Free up memory -->
                    <TextView
                        android:id="@+id/btnRam"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_icon_subtle_bg"
                        android:contentDescription="Free up memory"
                        android:drawableStart="@drawable/ic_ram_chip"
                        android:drawablePadding="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusLeft="@+id/btnScreensaver"
                        android:nextFocusRight="@+id/btnPower"
                        android:nextFocusDown="@+id/grid" />

                    <!-- 5. Turn off now -->
                    <TextView
                        android:id="@+id/btnPower"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/pill_icon_subtle_bg"
                        android:contentDescription="Turn off now"
                        android:drawableStart="@drawable/ic_power"
                        android:drawablePadding="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:nextFocusLeft="@+id/btnRam"
                        android:nextFocusRight="@+id/btnSettings"
                        android:nextFocusDown="@+id/grid" />

                    <!-- Hidden / Optional buttons preserved for compatibility -->
                    <TextView
                        android:id="@+id/btnInputs"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnReorder"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnLibraryTop"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Pill B: Separate Settings Capsule Button (60dp height, 30dp radius, 16dp horizontal padding) -->
                <LinearLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pill_settings_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:nextFocusLeft="@+id/btnPower"
                    android:nextFocusDown="@+id/grid"
                    android:clipChildren="true"
                    android:clipToPadding="false">

                    <ImageView
                        android:id="@+id/iconSettings"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_settings"
                        android:tint="#FFFFFFFF"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/labelSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.04"
                        android:singleLine="true"
                        android:text="Settings"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
